    Instance.new("UICorner", BackButton).CornerRadius = UDim.new(0, 6)

    local LoadingLabel = Instance.new("TextLabel")
    LoadingLabel.Size = UDim2.new(1, -20, 0, 20)
    LoadingLabel.Position = UDim2.new(0, 10, 0.9, 0)
    LoadingLabel.BackgroundTransparency = 1
    LoadingLabel.Text = ""
    LoadingLabel.TextSize = 13
    LoadingLabel.Font = Enum.Font.GothamMedium
    LoadingLabel.TextColor3 = Color3.fromRGB(240, 200, 80)
    LoadingLabel.Parent = MainFrame

    local Option1Btn = Instance.new("TextButton")
    Option1Btn.Size = UDim2.new(0.9, 0, 0, 42)
    Option1Btn.Position = UDim2.new(0.05, 0, 0.1, 0)
    Option1Btn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    Option1Btn.Font = Enum.Font.GothamBold
    Option1Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Option1Btn.TextSize = 16
    Option1Btn.Parent = ButtonContainer
    Instance.new("UICorner", Option1Btn).CornerRadius = UDim.new(0, 6)

    local Option2Btn = Instance.new("TextButton")
    Option2Btn.Size = UDim2.new(0.9, 0, 0, 42)
    Option2Btn.Position = UDim2.new(0.05, 0, 0.4, 0)
    Option2Btn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    Option2Btn.Font = Enum.Font.GothamBold
    Option2Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Option2Btn.TextSize = 16
    Option2Btn.Parent = ButtonContainer
    Instance.new("UICorner", Option2Btn).CornerRadius = UDim.new(0, 6)

    Option1Btn.Text = "العربية"
    Option2Btn.Text = "English"

    local isFetching = false

    local function fetchServers(cursor)
        local url = string.format(
            "https://games.roblox.com/v1/games/%s/servers/Public?sortOrder=Asc&limit=100%s",
            tostring(PLACE_ID),
            cursor and ("&cursor=" .. cursor) or ""
        )

        local success, response = pcall(function() return game:HttpGet(url) end)

        if success then
            if string.find(response, "429") or string.find(response, "Too Many Requests") then
                return nil, "429"
            end
            
            -- Added pcall to JSONDecode to prevent crashes on bad responses
            local decodeSuccess, decoded = pcall(function() return HttpService:JSONDecode(response) end)
            if decodeSuccess then
                return decoded.data or {}, decoded.nextPageCursor
            end
        end
        return nil, "Error"
    end

    local function teleportToServer(serverInfo, lang)
        LoadingLabel.Text = (lang == "Arabic" and "جاري الاتصال... (اللاعبين: " or "Teleporting... (Players: ") .. tostring(serverInfo.playing) .. ")"
        
        local success = pcall(function()
            TeleportService:TeleportToPlaceInstance(PLACE_ID, serverInfo.id, LocalPlayer)
        end)

        if not success then
            LoadingLabel.Text = lang == "Arabic" and "فشل الاتصال!" or "Teleport failed!"
        end
    end

    local function loadServerList(lang)
        if isFetching then return end
        isFetching = true
        
        LoadingLabel.Text = lang == "Arabic" and "البحث عن سيرفرات..." or "Finding servers..."
        
        for _, child in ipairs(ScrollingFrame:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end

        local cursor = nil
        local foundServers = {}
        
        -- FIX: Increased page limit from 4 to 20 to bypass "0 player ghost servers"
        for i = 1, 20 do 
            LoadingLabel.Text = (lang == "Arabic" and "جاري البحث في الصفحة " or "Scanning page ") .. tostring(i) .. "..."
            
            local servers, nextCursor = fetchServers(cursor)
            
            if nextCursor == "429" then
                LoadingLabel.Text = lang == "Arabic" and "تم الحظر مؤقتاً! انتظر..." or "Rate Limited! Waiting..."
                task.wait(3)
                continue
            elseif not servers then
                break
            end

            for _, server in ipairs(servers) do
                if server.id ~= JOB_ID and server.playing > 0 and server.playing < server.maxPlayers then
                    table.insert(foundServers, server)
                end
            end

            if #foundServers >= 10 then break end -- Stop when we have enough good servers
            
            cursor = nextCursor
            if not cursor then break end
            task.wait(1.2) -- Safe delay to avoid getting rate-limited
        end

        table.sort(foundServers, function(a, b) return a.playing < b.playing end)

        if #foundServers == 0 then
            LoadingLabel.Text = lang == "Arabic" and "لم يتم العثور على سيرفرات صالحة!" or "No valid servers found!"
            isFetching = false
            return
        end

        for index, server in ipairs(foundServers) do
            local ServerBtn = Instance.new("TextButton")
            ServerBtn.Size = UDim2.new(1, -10, 0, 35)
            ServerBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
            ServerBtn.Text = string.format("%s %d/%d", lang == "Arabic" and "اللاعبين:" or "Players:", server.playing, server.maxPlayers)
            ServerBtn.TextSize = 14
            ServerBtn.Font = Enum.Font.GothamMedium
            ServerBtn.TextColor3 = Color3.fromRGB(220, 220, 220)
            ServerBtn.Parent = ScrollingFrame
            Instance.new("UICorner", ServerBtn).CornerRadius = UDim.new(0, 4)

            ServerBtn.MouseButton1Click:Connect(function()
                teleportToServer(server, lang)
            end)
        end

        ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, #foundServers * 40)
        LoadingLabel.Text = lang == "Arabic" and "اختر سيرفر من القائمة" or "Choose a server from the list"
        
        ButtonContainer.Visible = false
        ListContainer.Visible = true
        isFetching = false
    end

    local function showServerButtons(language)
        Title.Text = language == "Arabic" and "اختر نوع السيرفر" or "Choose Server Type"
        
        Option1Btn.BackgroundColor3 = Color3.fromRGB(40, 110, 60)
        Option1Btn.Text = language == "Arabic" and "قائمة السيرفرات (لاعبين أقل)" or "Low Server List"
        
        Option2Btn.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
        Option2Btn.Text = language == "Arabic" and "سيرفر عشوائي" or "Random Server"

        local newOpt1 = Option1Btn:Clone()
        Option1Btn:Destroy()
        Option1Btn = newOpt1
        Option1Btn.Parent = ButtonContainer

        local newOpt2 = Option2Btn:Clone()
        Option2Btn:Destroy()
        Option2Btn = newOpt2
        Option2Btn.Parent = ButtonContainer

        Option1Btn.MouseButton1Click:Connect(function()
            loadServerList(language)
        end)

        Option2Btn.MouseButton1Click:Connect(function()
            if isFetching then return end
            isFetching = true
            LoadingLabel.Text = language == "Arabic" and "جلب سيرفر عشوائي..." or "Fetching random server..."
            
            local cursor = nil
            local valid = {}
            
            -- Scan up to 5 pages for random servers to ensure we skip empty ones
            for i = 1, 5 do
                local servers, nextCursor = fetchServers(cursor)
                if servers then
                    for _, s in ipairs(servers) do
                        if s.id ~= JOB_ID and s.playing > 0 and s.playing < s.maxPlayers then
                            table.insert(valid, s)
                        end
                    end
                end
                cursor = nextCursor
                if not cursor or #valid >= 20 then break end
                task.wait(1)
            end

            if #valid > 0 then
                teleportToServer(valid[math.random(1, #valid)], language)
            else
                LoadingLabel.Text = language == "Arabic" and "لم يتم العثور على سيرفر!" or "No servers found!"
            end
            isFetching = false
        end)
    end

    Option1Btn.MouseButton1Click:Connect(function() showServerButtons("Arabic") end)
    Option2Btn.MouseButton1Click:Connect(function() showServerButtons("English") end)

    BackButton.MouseButton1Click:Connect(function()
        ListContainer.Visible = false
        ButtonContainer.Visible = true
        LoadingLabel.Text = ""
    end)
end

-- ==========================================
-- 3. Execute script flow
-- ==========================================
showLoadingScreen(createMainUI)
