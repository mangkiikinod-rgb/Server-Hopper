local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local PLACE_ID = game.PlaceId
local JOB_ID = game.JobId

-- ==========================================
-- 1. RGB Loading Screen ("Raii Scripts")
-- ==========================================
local function showLoadingScreen(callback)
    local LoadGui = Instance.new("ScreenGui")
    LoadGui.Name = "RaiiScriptsLoader"
    LoadGui.Parent = game.CoreGui
    LoadGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

    local Background = Instance.new("Frame")
    Background.Size = UDim2.new(1, 0, 1, 0)
    Background.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    Background.BorderSizePixel = 0
    Background.Parent = LoadGui

    local RgbText = Instance.new("TextLabel")
    RgbText.Size = UDim2.new(0, 400, 0, 100)
    RgbText.Position = UDim2.new(0.5, -200, 0.5, -50)
    RgbText.BackgroundTransparency = 1
    RgbText.Text = "Raii Scripts"
    RgbText.Font = Enum.Font.GothamBlack
    RgbText.TextSize = 50
    RgbText.Parent = Background

    local LoadingSub = Instance.new("TextLabel")
    LoadingSub.Size = UDim2.new(0, 400, 0, 30)
    LoadingSub.Position = UDim2.new(0.5, -200, 0.5, 30)
    LoadingSub.BackgroundTransparency = 1
    LoadingSub.Text = "Loading Server Hopper..."
    LoadingSub.TextColor3 = Color3.fromRGB(150, 150, 150)
    LoadingSub.Font = Enum.Font.GothamMedium
    LoadingSub.TextSize = 18
    LoadingSub.Parent = Background

    -- RGB Animation Loop
    local connection
    connection = RunService.RenderStepped:Connect(function()
        -- Smoothly cycles through RGB colors using tick()
        RgbText.TextColor3 = Color3.fromHSV(tick() % 3 / 3, 1, 1)
    end)

    -- Wait 3 seconds, clean up loader, and launch main UI
    task.spawn(function()
        task.wait(3)
        connection:Disconnect()
        
        -- Fade out effect
        for i = 0, 1, 0.1 do
            Background.BackgroundTransparency = i
            RgbText.TextTransparency = i
            LoadingSub.TextTransparency = i
            task.wait(0.05)
        end
        
        LoadGui:Destroy()
        callback() -- Calls the main UI function
    end)
end

-- ==========================================
-- 2. Main Server Hopper UI & Logic
-- ==========================================
